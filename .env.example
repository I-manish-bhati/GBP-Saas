# Copy to .env.local and fill in real values. Never commit .env.local.

# App
APP_URL=http://localhost:3000
STAGING_URL=

# Supabase (server-side only — service_role bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key — NOT used by the app; only by scripts/verify-rls.ts
SUPABASE_ANON_KEY=
# Direct Postgres URI (Settings → Database → Connection string) — only for `npm run migrate`
SUPABASE_DB_URL=

# Google OAuth — Client A (owner → GBP connection, scope: business.manage)
GOOGLE_OWNER_OAUTH_CLIENT_ID=
GOOGLE_OWNER_OAUTH_CLIENT_SECRET=

# Google OAuth — Client B (customer QR login, scope: openid email profile) — separate Cloud project
GOOGLE_CUSTOMER_OAUTH_CLIENT_ID=
GOOGLE_CUSTOMER_OAUTH_CLIENT_SECRET=

# Google Gemini AI
GEMINI_API_KEY=

# Razorpay (test-mode keys: Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: Dashboard → Webhooks → secret (M8 verifies HMAC-SHA256 of raw body)
RAZORPAY_WEBHOOK_SECRET=
# AI slot price (FR-34: ₹299/location/month)
SLOT_PRICE_INR=299

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT signing — keep ADMIN_JWT_SECRET separate from JWT_SECRET
JWT_SECRET=
ADMIN_JWT_SECRET=

# Encryption for stored Google access/refresh tokens (32-byte hex: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# Upstash Redis (rate limiting; job queue only if D1 approved)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Resend (email verification + password reset)
RESEND_API_KEY=
EMAIL_FROM="App <no-reply@example.com>"

# Cron/job route auth (send as Authorization: Bearer <value>)
CRON_SECRET=

# First-admin seed script (scripts/create-admin.ts) — never a public signup
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
